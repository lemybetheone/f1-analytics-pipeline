# Copy to .env and fill in. .env is git-ignored and must never be committed.
#
#   cp .env.example .env
#   git check-ignore .env      # must print: .env
#
# Every value below is read from the environment by both the ingestion code and
# dbt (SECURITY §1: one config source, no credentials in code or committed
# config). Nothing here may hold a real value.

# ---------------------------------------------------------------------------
# Source API — Jolpica-F1
# ---------------------------------------------------------------------------
# No credential required; the API is unauthenticated. Pacing is a *limit*, not
# a preference: 4 req/s burst and 500 req/hour sustained, with no rate-limit
# headers returned, so the client must count locally.
JOLPICA_BASE_URL=https://api.jolpi.ca/ergast/f1
JOLPICA_REQUESTS_PER_HOUR=500
JOLPICA_BURST_PER_SECOND=4

# ---------------------------------------------------------------------------
# Warehouse — Supabase Postgres
# ---------------------------------------------------------------------------
# Supabase dashboard → Connect (top bar), or Settings → Database.
#
# Pick the SESSION pooler unless your network has working IPv6. New Supabase
# projects expose the direct host over IPv6 only, and most home/office networks
# in practice are IPv4. The TRANSACTION pooler (port 6543) is the wrong choice
# here: it does not hold session state, which breaks dbt.
#
#   Session pooler  → aws-0-<region>.pooler.supabase.com : 5432   <- use this
#   Direct          → db.<project-ref>.supabase.co       : 5432   (IPv6 only)
#   Transaction     → aws-0-<region>.pooler.supabase.com : 6543   (do not use)
WAREHOUSE_HOST=aws-0-<region>.pooler.supabase.com
WAREHOUSE_PORT=5432
WAREHOUSE_DATABASE=postgres

# With the session pooler the username carries the project ref: postgres.<ref>
# With a direct connection it is just: postgres
WAREHOUSE_USER=postgres.<project-ref>

# Set when the project was created. Supabase does not show it again — reset it
# under Settings → Database → Reset database password if it was not saved.
# Rotation note (SECURITY §1): a pooler can take minutes to pick up a reset, so
# a brief auth failure straight after is expected, not a misconfiguration.
WAREHOUSE_PASSWORD=

# Schemas the pipeline owns. Kept separate so no layer writes outside its own.
WAREHOUSE_SCHEMA_RAW=raw
WAREHOUSE_SCHEMA_STAGING=staging
WAREHOUSE_SCHEMA_MARTS=marts

# ---------------------------------------------------------------------------
# Lake — S3-compatible object storage
# ---------------------------------------------------------------------------
# The IAM user backing these keys must be scoped to PutObject / GetObject /
# ListBucket on this one bucket only, with no DeleteObject (SECURITY §2), and
# must not be the account root. The connectivity probe asserts both.
# Bucket region should match the warehouse region to keep transfer local.
LAKE_BUCKET=
LAKE_REGION=us-east-1
LAKE_PREFIX=raw
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ---------------------------------------------------------------------------
# Environment
# ---------------------------------------------------------------------------
# dev = personal schema, small volumes. prod = scheduled runs, full volumes.
TARGET_ENV=dev
